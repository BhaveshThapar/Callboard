# Neon Postgres. Copy the pooled connection string from the Neon console.
DATABASE_URL="postgresql://user:password@ep-xxx-pooler.region.aws.neon.tech/neondb?sslmode=require"

# Base URL the seed script prints judge and board links against -- and, on a deployed host, the
# only thing an absolute link can be built from. Unset in production it is not merely cosmetic:
# `announce.ts` sets `unsubscribeUrl: null` when it cannot form one, so an announcement ships with
# no opt-out line and no List-Unsubscribe header at all, and an invitation email carries a relative
# path that is dead in a mail client.
NEXT_PUBLIC_BASE_URL="http://localhost:3000"

# C2, the comms engine. Sending is opt-in on BOTH of these: without them `transportFromEnv` selects
# the recording transport, which returns ok, so `sweep` marks every message `sent` with a null
# `provider_ref` and nobody receives anything. COMMS_FROM must be an address on a domain verified
# with the provider.
#
# ORDERING, and it is not stylistic: set these BEFORE CRON_SECRET below. A sweep against the
# recording transport lands messages at `sent` and scrubs the raw invitation link out of the
# payload (ADR-0021), and `messages_comp_dedupe_unique` then refuses a re-enqueue -- so anything
# queued is permanently marked sent, having reached nobody.
RESEND_API_KEY=""
COMMS_FROM=""

# Authorizes GET /api/cron/send, which is what actually drains the outbox. Unset, the route 503s to
# everybody and the queue never moves. It must match the CRON_SECRET set in GitHub Actions *secrets*;
# PRODUCTION_URL beside it is a repository *variable*, so that a failing sweep can name the host it
# asked instead of printing a masked `***`. .github/workflows/comms.yml is the scheduler, because
# Vercel Cron on the Hobby plan allows one run per day.
CRON_SECRET=""

# A11, Google Drive import. All three are required together; without them the importer says it is
# not configured rather than starting a flow it cannot finish.
#
# DRIVE_TOKEN_KEY is 32 bytes, base64. It encrypts the Google refresh token at rest -- the one
# recoverable secret in this system, because a refresh token has to be replayed at Google and so
# cannot be hashed like every other credential here. Without it, connecting is refused rather than
# storing a token in the clear. Generate with:
#   node -e "console.log(require('node:crypto').randomBytes(32).toString('base64'))"
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
DRIVE_TOKEN_KEY=""
