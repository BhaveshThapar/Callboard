# Neon Postgres. Copy the pooled connection string from the Neon console.
DATABASE_URL="postgresql://user:password@ep-xxx-pooler.region.aws.neon.tech/neondb?sslmode=require"

# Base URL the seed script prints judge and board links against.
NEXT_PUBLIC_BASE_URL="http://localhost:3000"

# A11, Google Drive import. All three are required together; without them the importer says it is
# not configured rather than starting a flow it cannot finish.
#
# DRIVE_TOKEN_KEY is 32 bytes, base64. It encrypts the Google refresh token at rest -- the one
# recoverable secret in this system, because a refresh token has to be replayed at Google and so
# cannot be hashed like every other credential here. Without it, connecting is refused rather than
# storing a token in the clear. Generate with:
#   node -e "console.log(require('node:crypto').randomBytes(32).toString('base64'))"
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
DRIVE_TOKEN_KEY=""
